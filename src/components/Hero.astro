---
import { Image } from "astro:assets";
import { featuredPhotos } from "../content/photos";
import { weddingContent } from "../content/wedding";

interface Props {
  message: string;
  detailsAnchor: `#${string}`;
}

const { message, detailsAnchor } = Astro.props;
const { couple, hero, ceremony } = weddingContent;
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero__ornament hero__ornament--one" aria-hidden="true"></div>
  <div class="hero__ornament hero__ornament--two" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">
      <span>{couple.partnerOne}</span>
      <span class="hero__ampersand" aria-hidden="true">&amp;</span>
      <span>{couple.partnerTwo}</span>
    </h1>

    <p class="hero__message">{message}</p>

    <div class="hero__meta" aria-label="Fecha y lugar de la boda">
      <time
        datetime={ceremony.dateIso}
        class:list={{ "is-placeholder": ceremony.date.pending }}
        >{ceremony.date.value}</time
      >
      <span class="hero__meta-separator" aria-hidden="true"></span>
      <span class:list={{ "is-placeholder": ceremony.venue.pending }}
        >{ceremony.venue.value}</span
      >
    </div>

    <a class="button button--primary" href={detailsAnchor}>
      {hero.callToAction}
      <span aria-hidden="true">↓</span>
    </a>
  </div>

  <figure class="hero__photo">
    <div class="hero__photo-frame">
      <Image
        src={featuredPhotos.hero.src}
        alt={featuredPhotos.hero.alt}
        width={1280}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 900px) 44vw, 92vw"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${featuredPhotos.hero.position}`}
      />
    </div>
    <figcaption>Una vida, una historia, un sí.</figcaption>
  </figure>

  <a
    class="hero__scroll"
    href={detailsAnchor}
    aria-label="Ir a los detalles de la Eucaristía"
  >
    <span aria-hidden="true">Descubre</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>
