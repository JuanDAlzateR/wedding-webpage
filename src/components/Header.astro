---
import type { InvitationNavigationItem } from "../content/invitations";
import { weddingContent } from "../content/wedding";

const { initials, partnerOne, partnerTwo } = weddingContent.couple;

interface Props {
  navigation: readonly InvitationNavigationItem[];
}

const { navigation } = Astro.props;
const desktopNavigationColumns = Math.ceil(navigation.length / 2);
---

<header class="site-header">
  <a
    class="site-header__brand"
    href="#inicio"
    aria-label={`Inicio: boda de ${partnerOne} y ${partnerTwo}`}
  >
    <span aria-hidden="true">{initials}</span>
  </a>

  <nav
    class="site-header__nav site-header__nav--desktop"
    aria-label="Navegación principal"
    style={`--navigation-items: ${navigation.length}; --navigation-columns: ${desktopNavigationColumns};`}
  >
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <details class="site-header__menu">
    <summary>Menú</summary>
    <nav aria-label="Navegación principal en móvil">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </details>
</header>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>(".site-header__menu")
    .forEach((menu) => {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.removeAttribute("open"));
      });
    });
</script>
