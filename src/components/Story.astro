---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { weddingContent } from "../content/wedding";
import { featuredPhotos } from "../content/photos";

const { story } = weddingContent;
---

<section
  class="section section--story"
  id="historia"
  aria-labelledby="story-title"
>
  <div class="section__inner story-layout">
    <figure class="story-layout__photo">
      <Image
        src={featuredPhotos.story.src}
        alt={featuredPhotos.story.alt}
        width={960}
        widths={[480, 720, 960]}
        sizes="(min-width: 800px) 46vw, 92vw"
        format="webp"
        quality={86}
        loading="lazy"
        style={`object-position: ${featuredPhotos.story.position}`}
      />
      <span class="story-layout__caption" aria-hidden="true"
        >Nuestros recuerdos</span
      >
    </figure>

    <div class="story-layout__content">
      <SectionHeading
        id="story-title"
        eyebrow="Capítulo a capítulo"
        title="Nuestra historia"
      />
      <div class:list={["story-copy", { "is-placeholder": story.pending }]}>
        {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {story.pending && <span class="pending-label">Historia pendiente</span>}
    </div>
  </div>
</section>
