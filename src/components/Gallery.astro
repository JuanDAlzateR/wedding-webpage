---
import { Image } from "astro:assets";
import BiblicalQuote from "./BiblicalQuote.astro";
import { getHomeGallerySegments } from "../content/home-gallery";
import { weddingContent } from "../content/wedding";

const segments = getHomeGallerySegments();
const { galleryIntroduction } = weddingContent.biblicalQuotes;
---

<section
  class="section section--gallery"
  id="galeria"
  aria-labelledby="gallery-title"
>
  <div class="section__inner">
    <h2 class="visually-hidden" id="gallery-title">Galería de nuestro amor</h2>
    <BiblicalQuote quote={galleryIntroduction} variant="introduction" />

    <div class="gallery-journey">
      {
        segments.map((segment, segmentIndex) => (
          <div class="gallery-journey__segment">
            <div
              class="gallery-masonry"
              aria-label={`Galería, tramo ${segmentIndex + 1} de ${segments.length}`}
            >
              {segment.photos.map((photo) => (
                <figure
                  class="gallery-photo"
                  data-home-gallery-photo-id={photo.id}
                >
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={760}
                    widths={[360, 520, 760]}
                    sizes="(min-width: 1000px) 30vw, (min-width: 640px) 46vw, 92vw"
                    format="webp"
                    quality={84}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>

            {segment.quote && (
              <BiblicalQuote quote={segment.quote} variant="interlude" />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
