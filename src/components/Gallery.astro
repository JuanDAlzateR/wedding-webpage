---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { galleryPhotos } from "../content/photos";
---

<section
  class="section section--gallery"
  id="fotos"
  aria-labelledby="gallery-title"
>
  <div class="section__inner">
    <SectionHeading
      id="gallery-title"
      eyebrow="Instantes compartidos"
      title="Nuestra galería"
      align="center"
    />
    <p class="section-intro">
      Algunos recuerdos que guardamos con especial cariño.
    </p>

    <div class="gallery-grid">
      {
        galleryPhotos.map((photo) => (
          <figure
            class:list={["gallery-card", `gallery-card--${photo.layout}`]}
          >
            <Image
              class="gallery-card__image"
              src={photo.src}
              alt={photo.alt}
              width={photo.layout === "feature" ? 1280 : 760}
              widths={
                photo.layout === "feature"
                  ? [480, 760, 1040, 1280]
                  : [320, 520, 760]
              }
              sizes={
                photo.layout === "feature"
                  ? "92vw"
                  : "(min-width: 800px) 30vw, 46vw"
              }
              format="webp"
              quality={84}
              loading="lazy"
              decoding="async"
              style={`object-position: ${photo.position}`}
            />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>
