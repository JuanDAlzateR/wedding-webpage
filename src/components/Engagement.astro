---
import SectionHeading from "./SectionHeading.astro";
import { weddingContent } from "../content/wedding";

const { engagement } = weddingContent;
const engagementPath = `${import.meta.env.BASE_URL}compromiso/`;
---

<section
  class="section section--engagement"
  id="historia"
  aria-labelledby="engagement-title"
>
  <div class="engagement-ornament" aria-hidden="true">&amp;</div>
  <div class="section__inner engagement-layout">
    <SectionHeading
      id="engagement-title"
      eyebrow={engagement.eyebrow}
      title={engagement.title}
      light
    />
    <div class="engagement-card">
      <p>{engagement.summary}</p>
      <a class="button button--accent" href={engagementPath}>
        {engagement.callToAction}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
