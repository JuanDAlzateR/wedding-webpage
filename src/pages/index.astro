---
import AdditionalInfo from "../components/AdditionalInfo.astro";
import DressCode from "../components/DressCode.astro";
import Engagement from "../components/Engagement.astro";
import EventDetails from "../components/EventDetails.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Story from "../components/Story.astro";
import { featuredPhotos } from "../content/photos";
import { weddingContent } from "../content/wedding";
import BaseLayout from "../layouts/BaseLayout.astro";

const { sections, seo } = weddingContent;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  socialImage={featuredPhotos.social}
>
  <Header />
  <main id="contenido">
    <Hero />
    {sections.details && <EventDetails />}
    {sections.dressCode && <DressCode />}
    {sections.story && <Story />}
    {sections.engagement && <Engagement />}
    {sections.gallery && <Gallery />}
    {sections.additionalInfo && <AdditionalInfo />}
  </main>
  <Footer />
</BaseLayout>
