---
import { Image } from "astro:assets";
import { howWeMetStoryEntries } from "../content/how-we-met";
import { howWeMetFeaturedPhoto } from "../content/photos";
import {
  weddingContent,
  type HowWeMetStoryComposition,
} from "../content/wedding";
import BaseLayout from "../layouts/BaseLayout.astro";

const { couple, howWeMet } = weddingContent;
const visibleEntries = howWeMetStoryEntries.filter((entry) => entry.visible);
const visiblePhotoCount = visibleEntries.reduce(
  (total, entry) => total + entry.photos.length,
  0,
);
const imageSizes: Record<HowWeMetStoryComposition, string> = {
  single: "(min-width: 1000px) 56vw, (min-width: 700px) 70vw, 92vw",
  "stack-left": "(min-width: 1000px) 27vw, (min-width: 700px) 44vw, 92vw",
  "pair-below": "(min-width: 1000px) 38vw, (min-width: 700px) 46vw, 92vw",
  "split-stacks": "(min-width: 1000px) 24vw, (min-width: 700px) 44vw, 92vw",
};
const basePath = import.meta.env.BASE_URL;
const homePath = basePath;
---

<BaseLayout
  title={howWeMet.pageTitle}
  description={howWeMet.pageDescription}
  robots="noindex, nofollow"
  socialImage={howWeMetFeaturedPhoto.src}
  socialImageAlt={howWeMetFeaturedPhoto.alt}
>
  <header class="how-we-met-header">
    <a
      class="how-we-met-header__brand"
      href={homePath}
      aria-label={`Volver a la invitación de ${couple.partnerOne} y ${couple.partnerTwo}`}
    >
      {couple.initials}
    </a>
    <a class="how-we-met-header__back" href={homePath} data-return-link>
      Volver a la invitación <span aria-hidden="true">←</span>
    </a>
  </header>

  <main class="how-we-met-page" id="contenido">
    <section
      class="how-we-met-hero"
      id="inicio"
      aria-labelledby="how-we-met-title"
    >
      <div class="how-we-met-hero__ornament" aria-hidden="true">
        <span>{couple.initials}</span>
      </div>

      <div class="how-we-met-hero__copy">
        <p class="eyebrow">{howWeMet.eyebrow}</p>
        <h1 id="how-we-met-title">{howWeMet.title}</h1>
        <p>{howWeMet.summary}</p>
        <a class="button button--accent" href="#recorrido">
          Recorrer nuestra historia <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p
        class="how-we-met-hero__folio"
        aria-label={`${visibleEntries.length} momentos y ${visiblePhotoCount} fotografías`}
      >
        <span>{String(visibleEntries.length).padStart(2, "0")}</span>
        momentos
        <span>{String(visiblePhotoCount).padStart(2, "0")}</span>
        fotografías
      </p>
    </section>

    <section
      class="section how-we-met-story"
      id="recorrido"
      aria-labelledby="how-we-met-story-title"
    >
      <div class="section__inner">
        <header class="how-we-met-story__introduction">
          <p class="eyebrow">{howWeMet.storyEyebrow}</p>
          <h2 id="how-we-met-story-title">{howWeMet.storyTitle}</h2>
        </header>

        <ol class="how-we-met-entries">
          {
            visibleEntries.map((entry, entryIndex) => {
              const entryNumber = String(entryIndex + 1).padStart(2, "0");
              const headingId = `how-we-met-entry-${entry.id}`;

              return (
                <li>
                  <article
                    class:list={[
                      "how-we-met-entry",
                      `how-we-met-entry--${entry.composition}`,
                    ]}
                    aria-labelledby={headingId}
                    data-story-entry={entry.id}
                    data-story-composition={entry.composition}
                  >
                    <div class="how-we-met-entry__copy">
                      <p class="how-we-met-entry__number">
                        Recuerdo {entryNumber}
                      </p>
                      <h3 class="visually-hidden" id={headingId}>
                        Momento {entryNumber} de nuestra historia
                      </h3>
                      {entry.title && <h4>{entry.title}</h4>}
                      <p>{entry.description.value}</p>
                      {entry.caption && (
                        <p class="how-we-met-entry__caption">{entry.caption}</p>
                      )}
                    </div>

                    <div
                      class="how-we-met-entry__photos"
                      aria-label={`Fotografías del recuerdo ${entryNumber}`}
                    >
                      {entry.photos.map((photo, photoIndex) => (
                        <figure
                          class:list={[
                            "how-we-met-photo",
                            photo.src.width >= photo.src.height
                              ? "how-we-met-photo--landscape"
                              : "how-we-met-photo--portrait",
                          ]}
                          data-how-we-met-photo-id={photo.id}
                          data-photo-position={photoIndex + 1}
                        >
                          <Image
                            src={photo.src}
                            alt={photo.alt}
                            width={
                              photo.src.width >= photo.src.height ? 1200 : 840
                            }
                            widths={[360, 520, 760, 960, 1200]}
                            sizes={imageSizes[entry.composition]}
                            format="webp"
                            quality={86}
                            loading="lazy"
                            decoding="async"
                          />
                        </figure>
                      ))}
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>
  </main>

  <footer class="how-we-met-footer">
    <p>{couple.partnerOne} &amp; {couple.partnerTwo}</p>
    <a href={homePath} data-return-link>Volver a la invitación</a>
  </footer>

  <script is:inline define:vars={{ basePath }}>
    const returnLinks = document.querySelectorAll("[data-return-link]");
    const referrer = document.referrer ? new URL(document.referrer) : null;
    const invitationPrefix = `${basePath}invitacion/`;
    const canReturn =
      referrer?.origin === window.location.origin &&
      (referrer.pathname === basePath ||
        referrer.pathname.startsWith(invitationPrefix));

    if (canReturn) {
      returnLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          window.history.back();
        });
      });
    }
  </script>
</BaseLayout>
